{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Host": {
    "Ip": "0.0.0.0",
    "Port": 3000
  },
  "Retention": {
    "Enabled": true,
    "DefaultTtlSeconds": 604800,
    "CheckIntervalSeconds": 3600
  },
  "Src": {
    "HttpTimeoutSeconds": 30
  },
  "SitesRoot": "./sites",
  "MaxFileSizeBytes": 1048576,
  "MaxPayloadSizeBytes": 1048576,
  "MaxSubmissionSizeBytes": 1048576
}
