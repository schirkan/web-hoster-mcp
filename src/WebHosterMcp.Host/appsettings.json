{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Host": {
    "Ip": "0.0.0.0",
    "Port": 3000,
    "HttpsPort": 3443,
    "UseHttps": true
  },
  "Https": {
    "CertPath": null,
    "CertPassword": "changeme",
    "SelfSigned": {
      "Enabled": true,
      "CertDir": "./certs",
      "Cn": null,
      "ForceRegenerate": false
    }
  },
  "Retention": {
    "Enabled": true,
    "DefaultTtlSeconds": 604800,
    "CheckIntervalSeconds": 3600
  },
  "Src": {
    "HttpTimeoutSeconds": 30
  },
  "SitesRoot": "./sites",
  "MaxFileSizeBytes": 1048576
}
